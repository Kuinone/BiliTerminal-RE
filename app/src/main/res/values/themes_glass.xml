<?xml version="1.0" encoding="utf-8"?>
<!-- 「玻璃质感」主题覆盖层：GlassStyle.applyTo 在 BaseActivity.onCreate 里 theme.applyStyle(…, force=true)。
     只替换卡片 / 按钮两个组件样式引用（具体样式，不走 ?attr 间接层），关闭时不叠加、零开销。
     卡片 / 按钮的 elevation 必须为 0：半透明底下面的阴影会透出来，形成脏边。 -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="CardStyle.Glass" parent="CardStyle">
        <item name="cardBackgroundColor">@color/glass_card_pink</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_stroke_pink</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor" tools:ignore="PrivateResource">@color/glass_ripple_pink</item>
    </style>

    <style name="ButtonStyle.Glass" parent="ButtonStyle">
        <item name="backgroundTint">@color/glass_btn_bg_pink</item>
        <item name="strokeColor">@color/glass_btn_stroke_pink</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/glass_ripple_pink</item>
        <item name="android:textColor">@color/glass_btn_text_pink</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation" tools:ignore="NewApi">0dp</item>
        <item name="android:stateListAnimator" tools:ignore="NewApi">@null</item>
    </style>

    <!-- B站粉 -->
    <style name="GlassOverlay.Pink" parent="">
        <item name="choiceCardColor">@color/glass_card_pink</item>
        <item name="actionCardColor">@color/glass_btn_bg_fill_pink</item>
        <item name="actionCardStroke">@color/glass_btn_stroke_pink</item>
        <item name="secondaryButtonTint">@color/glass_btn_secondary</item>
        <item name="materialCardViewStyle">@style/CardStyle.Glass</item>
        <item name="materialButtonStyle">@style/ButtonStyle.Glass</item>
    </style>


<?xml version="1.0" encoding="utf-8"?>
<!--
  短视频页外壳：一个横向 ViewPager，把「短视频流 → 视频详情 → 评论 → 相关推荐」串成一条线。

  - 第 0 页：fragment_short_video_feed（竖向短视频流，懒加载、循环续接都在这里）
  - 第 1 页：视频详情（复用 VideoInfoFragment）
  - 第 2 页：评论（复用 ReplyFragment）
  - 第 3 页：相关推荐（复用 VideoRcmdFragment；设置里关掉相关推荐时没有这一页）

  用经典 ViewPager（与普通视频详情页同款）而不是 ViewPager2：横向翻页交给它原生处理，
  不经过「自定义手势 → fakeDrag → RecyclerView」链路，跟手/吸附更稳；右滑退出只由
  第 0 页根布局 SwipePageLayout 单独判断。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/short_video_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
